{
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/server" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, must-revalidate" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron/trial-reminders", "schedule": "0 13 * * *" }
  ]
}
