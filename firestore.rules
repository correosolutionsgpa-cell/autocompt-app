rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is logged in
    function isSignedIn() {
      return request.auth != null;
    }

    // Founder/superadmin allowlist — mirrors the client-side check in
    // App.tsx's getEffectiveTier().
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'correo.solutionsgpa@gmail.com' ||
        request.auth.token.email == 'solutionsgpa@gmail.com' ||
        request.auth.token.email.matches('.*solutionsgpa.*') ||
        request.auth.token.email.matches('^fabiola.*') ||
        request.auth.token.email.matches('.*@autocompt[.]ca$')
      );
    }

    // Narrow delegated role — a QA tester's own users/{uid} doc gets this
    // flag flipped by SuperAdmin (never self-service). It only unlocks
    // BetaCodeAdminView / the betaCodes rules below, nothing else.
    function isBetaCodeAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('canGenerateBetaCodes', false) == true;
    }

    // User profile document rules
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      // A user always owns their own doc. SuperAdmin may ALSO write another
      // user's doc, but only to flip these specific admin-controlled fields —
      // never anything else on someone else's profile. driveEnabled and
      // unlockedProfiles added 2026-08-11: SuperAdminPanel's toggles for
      // these were silently rejected by this rule (only canGenerateBetaCodes
      // was allowed) whenever used on an account other than the admin's own.
      allow write: if isSignedIn() && (
        request.auth.uid == userId ||
        (isSuperAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['canGenerateBetaCodes', 'driveEnabled', 'unlockedProfiles']))
      );
    }

    // General collection rules with multi-tenant isolation by ownerId.
    // NOTE: `request.resource` only exists on writes — referencing it inside
    // a combined `allow read, write` rule makes every read (get AND query)
    // evaluate that clause too, which errors out and denies the read. Reads
    // and writes are split below so each only references what's defined for it.
    function isOwnerDoc() {
      return isSignedIn() && resource.data.ownerId == request.auth.uid;
    }
    function isOwnerWrite() {
      return isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }
    // A business partner added to a company's collaboratorUIDs (via the real
    // invite flow below) — read-only for now on the company doc itself.
    function isCollaboratorDoc() {
      return isSignedIn() && request.auth.uid in resource.data.get('collaboratorUIDs', []);
    }
    // Same idea, for records that belong to a shared company rather than the
    // `companies` doc itself: expenses/invoices/properties/etc. store a
    // `companyId` field equal to the `companies` doc's own id, so this looks
    // that company doc up and checks the requesting user is on its
    // collaboratorUIDs list. Read-only, mirroring isCollaboratorDoc().
    function isCollaboratorOnCompany() {
      return isSignedIn() && resource.data.companyId != null &&
        request.auth.uid in get(/databases/$(database)/documents/companies/$(resource.data.companyId)).data.get('collaboratorUIDs', []);
    }
    // Narrow write for a collaborator (e.g. an accountant linked to a client's
    // real company) — lets them append to the notes thread on an expense/
    // invoice they don't own, without granting any access to the amount,
    // category, or any other field. Mirrors isAcceptingOwnInvite()'s
    // affectedKeys().hasOnly() pattern above.
    function isCollaboratorNoteUpdate() {
      return isSignedIn() && resource.data.companyId != null &&
        request.auth.uid in get(/databases/$(database)/documents/companies/$(resource.data.companyId)).data.get('collaboratorUIDs', []) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes']);
    }
    // Lets an invited user add themselves to a company's collaboratorUIDs —
    // only allowed when a matching *pending* invite exists (see
    // `companyInvites` below) and the update touches nothing else.
    function isAcceptingOwnInvite(companyId) {
      return isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['collaboratorUIDs']) &&
        request.auth.uid in request.resource.data.collaboratorUIDs &&
        exists(/databases/$(database)/documents/companyInvites/$(companyId + '_invite_' + request.auth.token.email)) &&
        get(/databases/$(database)/documents/companyInvites/$(companyId + '_invite_' + request.auth.token.email)).data.status == 'pending';
    }

    match /companies/{companyId} {
      allow read: if isOwnerDoc() || isCollaboratorDoc();
      allow create: if isOwnerWrite();
      allow update: if isOwnerDoc() || isAcceptingOwnInvite(companyId);
      allow delete: if isOwnerDoc();
    }

    // Real invite flow — an owner invites a partner by email; the invite doc
    // id is deterministic (`{companyDocId}_invite_{email}`) so isAcceptingOwnInvite()
    // above can check its existence without a query. The invited person can
    // only read their own invite and flip it to 'accepted'; only the inviter
    // can create/delete invites.
    match /companyInvites/{inviteId} {
      allow read: if isSignedIn() && (
        resource.data.invitedByUid == request.auth.uid ||
        resource.data.invitedEmail == request.auth.token.email
      );
      allow create: if isSignedIn() && request.resource.data.invitedByUid == request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.invitedEmail == request.auth.token.email &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'accepted';
      allow delete: if isSignedIn() && resource.data.invitedByUid == request.auth.uid;
    }

    match /expenses/{expenseId} {
      allow read: if isOwnerDoc() || isCollaboratorOnCompany();
      allow create: if isOwnerWrite();
      allow update: if isOwnerDoc() || isCollaboratorNoteUpdate();
      allow delete: if isOwnerDoc();
    }

    match /invoices/{invoiceId} {
      allow read: if isOwnerDoc() || isCollaboratorOnCompany();
      allow create: if isOwnerWrite();
      allow update: if isOwnerDoc() || isCollaboratorNoteUpdate();
      allow delete: if isOwnerDoc();
    }

    match /docTemplates/{templateId} {
      allow read: if isOwnerDoc() || isCollaboratorOnCompany();
      allow create: if isOwnerWrite();
      allow update, delete: if isOwnerDoc();
    }

    // DocuLegal entries — Prospecteur/Investisseur/Flippeur/Gestionnaire
    // (leases, offers, subcontracts). Distinct from Syndicat's `legalDocuments`.
    match /docuLegalDocs/{docId} {
      allow read: if isOwnerDoc() || isCollaboratorOnCompany();
      allow create: if isOwnerWrite();
      allow update, delete: if isOwnerDoc();
    }

    // Public e-signature flow (DocuLegalPdfEditor → PublicSignaturePage,
    // used by both the Syndicat and Plex DocuLegal). The recipient signing
    // a document (tenant, chambreur, co-owner...) almost never has an
    // AutoCompt account — PublicSignaturePage.tsx reads/writes these two
    // collections with NO auth at all, by design (a "magic link" model: the
    // long random token in the URL IS the access control, same trust model
    // as e.g. a DocuSign envelope link). Found 2026-08-12: neither
    // collection had ANY rule here, so every read/write was silently
    // rejected by the default-deny catch-all below — the whole e-signature
    // send/sign flow was broken end to end, for every profile, the entire
    // time this feature has existed. Only account creation is gated (a
    // signed-in AutoCompt user has to be the one generating the link).
    match /pendingSignatures/{token} {
      allow read, update: if true;
      allow create: if isSignedIn();
      allow delete: if false;
    }
    // Keyed by the SIGNER's own email (see PublicSignaturePage.tsx) so a
    // returning public signer's saved signature is found again next time —
    // same public trust model as pendingSignatures above.
    match /savedSignatures/{key} {
      allow read, write: if true;
    }

    // Per-company Google Drive connection metadata (folder id, connected
    // email — never the OAuth token itself). Doc id is `{ownerId}_company_{id}`,
    // scoped the same way as `companies`, since the app's internal company ids
    // ("1", "2"...) repeat across every account.
    match /companyDriveConfig/{configId} {
      allow read: if isOwnerDoc() || isCollaboratorOnCompany();
      allow create: if isOwnerWrite();
      allow update, delete: if isOwnerDoc();
    }

    match /properties/{propertyId} {
      allow read: if isOwnerDoc() || isCollaboratorOnCompany();
      allow create: if isOwnerWrite();
      allow update, delete: if isOwnerDoc();
    }

    // DPA/CCA (déduction pour amortissement) tracking — Comptable profile
    // only, per building per fiscal year. Same access shape as expenses/
    // invoices: owner or a linked collaborator (e.g. the accountant on a
    // client's real company) can read/write.
    match /ccaAssets/{assetId} {
      allow read: if isOwnerDoc() || isCollaboratorOnCompany();
      allow create: if isOwnerWrite();
      allow update, delete: if isOwnerDoc();
    }

    // Taxes & Assurances documents filed per property. This collection had
    // no rule at all before — every write was silently rejected by the
    // default-deny catch-all, so no document ever actually saved here.
    match /propertyDocuments/{docId} {
      allow read: if isOwnerDoc() || isCollaboratorOnCompany();
      allow create: if isOwnerWrite();
      allow update, delete: if isOwnerDoc();
    }

    match /loyers/{loyerId} {
      allow read: if isOwnerDoc() || isCollaboratorOnCompany();
      allow create: if isOwnerWrite();
      allow update, delete: if isOwnerDoc();
    }

    // Compte en Fidéicommis (gestionnaire) — clients, deposits, withdrawals.
    // Same gap as propertyDocuments above: no rule existed for these three
    // collections, so every read/write was silently rejected by the
    // default-deny catch-all at the bottom of this file.
    match /fideicommisClients/{clientId} {
      allow read: if isOwnerDoc() || isCollaboratorOnCompany();
      allow create: if isOwnerWrite();
      allow update, delete: if isOwnerDoc();
    }
    match /fideicommisDepots/{depotId} {
      allow read: if isOwnerDoc() || isCollaboratorOnCompany();
      allow create: if isOwnerWrite();
      allow update, delete: if isOwnerDoc();
    }
    match /fideicommisRetraits/{retraitId} {
      allow read: if isOwnerDoc() || isCollaboratorOnCompany();
      allow create: if isOwnerWrite();
      allow update, delete: if isOwnerDoc();
    }
    match /fideicommisConciliations/{conciliationId} {
      allow read: if isOwnerDoc() || isCollaboratorOnCompany();
      allow create: if isOwnerWrite();
      allow update, delete: if isOwnerDoc();
    }
    match /paieRecords/{recordId} {
      allow read: if isOwnerDoc() || isCollaboratorOnCompany();
      allow create: if isOwnerWrite();
      allow update, delete: if isOwnerDoc();
    }

    // Generic multi-client bookkeeping (comptable profile) — clients doc,
    // separate from fideicommisClients above (real-estate/trust-account only).
    match /bookkeepingClients/{clientId} {
      allow read: if isOwnerDoc() || isCollaboratorOnCompany();
      allow create: if isOwnerWrite();
      allow update, delete: if isOwnerDoc();
    }

    match /condoUnits/{unitId} {
      allow read: if isOwnerDoc() || isCollaboratorOnCompany();
      allow create: if isOwnerWrite();
      allow update, delete: if isOwnerDoc();
    }

    match /cotisationPayments/{paymentId} {
      allow read: if isOwnerDoc() || isCollaboratorOnCompany();
      allow create: if isOwnerWrite();
      allow update, delete: if isOwnerDoc();
    }

    match /communityPosts/{postId} {
      allow read: if isOwnerDoc() || isCollaboratorOnCompany();
      allow create: if isOwnerWrite();
      allow update, delete: if isOwnerDoc();
    }

    match /legalDocuments/{docId} {
      allow read: if isOwnerDoc() || isCollaboratorOnCompany();
      allow create: if isOwnerWrite();
      allow update, delete: if isOwnerDoc();
    }

    match /syndicSettings/{configId} {
      allow read: if isOwnerDoc() || isCollaboratorOnCompany();
      allow create: if isOwnerWrite();
      allow update, delete: if isOwnerDoc();
    }

    match /maintenance_components/{componentId} {
      allow read: if isOwnerDoc();
      allow create: if isOwnerWrite();
      allow update, delete: if isOwnerDoc();
    }

    match /buildings/{buildingId} {
      allow read: if isOwnerDoc() || isCollaboratorOnCompany();
      allow create: if isOwnerWrite();
      allow update, delete: if isOwnerDoc();
    }

    match /units/{unitId} {
      allow read: if isOwnerDoc() || isCollaboratorOnCompany();
      allow create: if isOwnerWrite();
      allow update, delete: if isOwnerDoc();
    }

    // GIFI code mapping override, per company — the accountant assigns real
    // GIFI/IGCF codes to AutoCompt's internal chart-of-accounts once, and it's
    // remembered for every future "Export GIFI (.csv)". Never machine-guessed
    // (see the comment in ComptableExportView.tsx): codes start blank and are
    // filled in by a human, exactly like every other AI/estimated value in
    // this app that must be confirmed before it's trusted.
    match /gifiMappings/{mappingId} {
      allow read: if isOwnerDoc() || isCollaboratorOnCompany();
      allow create: if isOwnerWrite();
      allow update, delete: if isOwnerDoc();
    }

    // Même principe que gifiMappings ci-dessus, mais pour le numéro de compte
    // du plan comptable Sage 50 du client — nécessaire une seule fois pour que
    // l'export "Journal .csv (Sage 50)" soit importable tel quel, sans ressaisie
    // manuelle par le comptable.
    match /sageMappings/{mappingId} {
      allow read: if isOwnerDoc() || isCollaboratorOnCompany();
      allow create: if isOwnerWrite();
      allow update, delete: if isOwnerDoc();
    }

    match /journalEntries/{entryId} {
      allow read: if isOwnerDoc();
      allow create: if isOwnerWrite();
      allow update, delete: if isOwnerDoc();
    }

    match /journalLines/{lineId} {
      allow read: if isOwnerDoc();
      allow create: if isOwnerWrite();
      allow update, delete: if isOwnerDoc();
    }

    // Relevé de Gestion — narrow cross-company channel between a gestionnaire
    // and a delegated-management investisseur (potentially a DIFFERENT
    // Firebase account entirely). Deliberately NOT the companyInvites/
    // collaboratorUIDs pattern — that grants full read/write on the whole
    // company. Each doc here only exposes itself to the two specific parties
    // named on it, nothing else of either side's books.
    match /statementLinks/{linkId} {
      allow read: if isSignedIn() && (
        resource.data.gestionnaireOwnerId == request.auth.uid ||
        resource.data.invitedEmail == request.auth.token.email ||
        resource.data.linkedOwnerUid == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.gestionnaireOwnerId == request.auth.uid;
      // Accepting: only the invited email may flip pending->accepted, and only
      // by setting linkedOwnerUid/linkedOwnerCompanyId — nothing else on the doc.
      allow update: if isSignedIn() &&
        resource.data.invitedEmail == request.auth.token.email &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'accepted' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'linkedOwnerUid', 'linkedOwnerCompanyId']);
      allow delete: if isSignedIn() && resource.data.gestionnaireOwnerId == request.auth.uid;
    }

    // Sealed statements — bank-statement style: once created, immutable
    // (mirrors aiUsageEvents' "Events are immutable" pattern below). Stores
    // only the computed totals, never the manager's raw depots/retraits —
    // the owner never gets read access to those.
    match /sealedStatements/{stmtId} {
      allow read: if isSignedIn() && (
        resource.data.sealedByUid == request.auth.uid ||
        resource.data.linkedOwnerUid == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.sealedByUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Live shared ledger — extends an ACCEPTED statementLink into a running,
    // redacted, property-scoped feed. Deliberately a NEW narrow collection,
    // not a loosening of expenses/invoices/fideicommisRetraits: those
    // collections' rules stay untouched, every read path on them keeps its
    // existing, already-audited scope. Only what the gestora explicitly
    // mirrors here is ever visible to the linked owner.
    match /sharedLedgerEntries/{entryId} {
      allow read: if isSignedIn() && (
        resource.data.gestionnaireOwnerId == request.auth.uid ||
        resource.data.linkedOwnerUid == request.auth.uid
      );
      // Only the gestora ever writes a mirror — a read-only projection of
      // their own real books for this one linked property, never a two-way
      // sync target. The owner never writes here directly (see
      // sharedLedgerPendingItems below for how their submissions get in).
      allow create, update: if isSignedIn() && request.resource.data.gestionnaireOwnerId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.gestionnaireOwnerId == request.auth.uid;
    }

    // Documents/expenses the OWNER submits for a linked property — NEVER
    // become a real record directly (same house rule as every other
    // AI/external-origin data in this app: a human must review before it's
    // trusted). The gestora reviews and, on approval, creates the real
    // fideicommisRetraits/expense record client-side and mirrors it into
    // sharedLedgerEntries above.
    match /sharedLedgerPendingItems/{itemId} {
      allow read: if isSignedIn() && (
        resource.data.gestionnaireOwnerId == request.auth.uid ||
        resource.data.linkedOwnerUid == request.auth.uid
      );
      // The owner may only submit against a link that is actually accepted
      // and actually theirs — same exists()+status guard shape as
      // isAcceptingOwnInvite() above, applied to statementLinks instead of
      // companyInvites.
      allow create: if isSignedIn() &&
        request.resource.data.linkedOwnerUid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        exists(/databases/$(database)/documents/statementLinks/$(request.resource.data.statementLinkId)) &&
        get(/databases/$(database)/documents/statementLinks/$(request.resource.data.statementLinkId)).data.status == 'accepted' &&
        get(/databases/$(database)/documents/statementLinks/$(request.resource.data.statementLinkId)).data.linkedOwnerUid == request.auth.uid;
      // Only the gestora reviews — flips status pending->approved/rejected
      // and stamps who/when/which real record resulted, nothing else.
      allow update: if isSignedIn() &&
        resource.data.gestionnaireOwnerId == request.auth.uid &&
        resource.data.status == 'pending' &&
        request.resource.data.status in ['approved', 'rejected'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedByUid', 'reviewedAt', 'approvedRecordId', 'rejectionReason']);
      allow delete: if false; // trazabilité — on rejette, on ne supprime jamais
    }

    // AI usage events — cost-tracking log (one doc per Gemini/Claude call).
    // Any signed-in user can log their own events; only SuperAdmin can read
    // the log (aggregated in the "Usage IA" tab). Events are immutable.
    match /aiUsageEvents/{eventId} {
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read: if isSuperAdmin();
      allow update, delete: if false;
    }

    // Platform invoices — AutoCompt's own SaaS billing (sequential numbering),
    // and the counter doc backing it. SuperAdmin-only in both directions:
    // only Fabiola issues invoices, so no client ever needs to write these.
    match /platformInvoices/{invoiceId} {
      allow read, create: if isSuperAdmin();
      allow update, delete: if false;
    }
    match /counters/{counterId} {
      allow read, write: if isSuperAdmin();
    }

    // Beta access codes — `get` must work BEFORE the user is authenticated
    // (redemption is checked during signup), so it's public by exact code
    // (doc ID) only. `list` (enumerating every code) is superadmin-only,
    // used by the admin "Codes Beta" tab.
    match /betaCodes/{code} {
      allow get: if true;
      // isBetaCodeAdmin can list too — a tester needs to see which emails/
      // codes already exist to avoid duplicates. Codes reveal only an email
      // + status, nothing sensitive.
      allow list: if isSuperAdmin() || isBetaCodeAdmin();
      allow create: if isSuperAdmin() || isBetaCodeAdmin();
      allow update: if isSignedIn()
        && resource.data.status == 'unused'
        && resource.data.email == request.auth.token.email
        && request.resource.data.status == 'redeemed';
      allow delete: if isSuperAdmin();
    }

    // Default deny — any collection not explicitly matched above is inaccessible.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
